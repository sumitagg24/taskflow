# Environment template — copy to .env and fill in your own values.
# .env is gitignored. Never commit real secrets.

PORT=

MONGO_URI=

JWT_SECRET=

JWT_REFRESH_SECRET=

CLIENT_URL=

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# GitHub OAuth app (https://github.com/settings/developers).
# Authorization callback URL must match GITHUB_CALLBACK_URL, which defaults to
# $CLIENT_URL/api/auth/github/callback.
GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=

GITHUB_CALLBACK_URL=

EMAIL_HOST=

EMAIL_PORT=

EMAIL_USER=

EMAIL_PASS=

AI_PROVIDER=

AI_API_KEY=
