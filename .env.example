# Environment template — copy to .env and fill in your own values.
# .env is gitignored. Never commit real secrets.

# TaskFlow runs the server + client from two directories, each with its own
# (gitignored) env file. The canonical templates live next to the code:
#
#   server/.env.example  — API keys, DB, JWT secrets, OAuth, email, rate limits
#   client/.env.example  — VITE_* build-time vars (OAuth client IDs, API URL)
#
# Copy them with:
#   copy server\.env.example server\.env
#   copy client\.env.example client\.env
#
# This root .env is NOT read by the app; it is kept only because older notes
# referenced it. PORT below is the traditional dev port for reference only.

PORT=5000
