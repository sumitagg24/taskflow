# Client environment template — copy to .env and fill in real values.
# .env is gitignored; never commit your real .env.

# Google OAuth Client ID — must match the one in server/.env.
# Get a client ID at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Auth0 — optional additive SSO (Universal Login). All three enable the
# "Continue with Auth0" button. Get them from Auth0 Dashboard > Application.
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=your_spa_client_id
# VITE_AUTH0_AUDIENCE= (optional API identifier, defaults to client ID)

# Split deploys — NOT needed for the single-service Railway deploy (the API
# serves the built SPA from the same origin). Set these only if you host the
# SPA somewhere else (e.g. Vercel) pointing at a Railway API:
# VITE_API_URL=https://<your-api>.up.railway.app/api
# VITE_SOCKET_URL=https://<your-api>.up.railway.app (API origin, no /api)
# These are baked in at build time — rebuild the client after changing them.
#
# For the single-service Railway deploy, Auth0/Google app settings need the
# deployed origin added: Allowed Callback URLs, Allowed Web Origins, and
# Allowed Logout URLs all get https://<your-app>.up.railway.app (plus your
# custom domain once bound).
