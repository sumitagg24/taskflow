# TaskFlow production env for the Oracle Cloud free-tier VM.
# Copy to deploy/oracle/.env.prod (chmod 600) and fill in. NEVER commit .env.prod.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (or reuse the values currently in server/.env — they are valid for prod)

# ── Database (keep the existing free Atlas M0 cluster — no migration) ─────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# ── Required in production (server refuses to boot without these) ─────────
JWT_SECRET=
JWT_REFRESH_SECRET=
# Required once any user saves a per-user AI provider key:
AI_KEY_SECRET=

# ── Origins ────────────────────────────────────────────────────────────────
# CLIENT_URL = the Vercel SPA origin (where users actually browse). Used for
# OAuth redirect targets and email links.
CLIENT_URL=https://taskflow-ebon-tau.vercel.app
# ALLOWED_ORIGINS = same SPA origin. Production CORS + CSRF are fail-closed.
ALLOWED_ORIGINS=https://taskflow-ebon-tau.vercel.app
PORT=5000

# ── OAuth (copy from server/.env; adjust provider dashboards after) ────────
AUTH0_DOMAIN=dev-g4w68c5tpeyhxh3d.us.auth0.com
AUTH0_CLIENT_ID=
# Google button runs through Auth0; direct Google is legacy/native-only:
GOOGLE_CLIENT_ID=
# GitHub OAuth app callback must be the API origin:
# GITHUB_CALLBACK_URL=https://<api-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email (optional — Resend preferred, falls back to SMTP, then Ethereal) ─
# RESEND_API_KEY=
# EMAIL_FROM=TaskFlow <no-reply@yourdomain.com>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=

# ── Ops (optional) ─────────────────────────────────────────────────────────
# LOG_LEVEL=info
# SENTRY_DSN=
# REDIS_URL=            # optional; in-memory limiting is fine on 1 instance
#
# ── Background jobs ──────────────────────────────────────────────────────
# Either leave the in-process intervals on (default, single instance) or set
# DISABLE_INTERVAL_JOBS=true and schedule POST /api/cron/:job externally
# (see .github/workflows/cron.yml + server/jobs/index.js for idempotency).
# DISABLE_INTERVAL_JOBS=false
# CRON_SECRET=          # 16+ chars; required to call /api/cron/:job
#
# ── Uploads ──────────────────────────────────────────────────────────────
# Local disk is durable here (uploads volume in docker-compose.yml). Switch
# to STORAGE_MODE=s3 + the S3_* vars only if you move off the VM volume.
# STORAGE_MODE=local
# S3_BUCKET= / S3_REGION= / S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=   # optional CDN base (e.g. CloudFront)
#
# ── Boot migrations ──────────────────────────────────────────────────────
# One-time migrations are an explicit step, never implicit on boot:
#   docker compose -f deploy/oracle/docker-compose.yml run --rm app npm run migrate
# Set RUN_MIGRATIONS_ON_BOOT=true only to keep the legacy boot behaviour.
# RUN_MIGRATIONS_ON_BOOT=false