# Server environment template — copy to .env and fill in real values.
# .env is gitignored; never commit your real .env.

# ── Required ──────────────────────────────────────────────────────────────
# MongoDB connection string. Examples:
#   local:        mongodb://127.0.0.1:27017/taskflow
#   Atlas:        mongodb+srv://user:pass@cluster.mongodb.net/taskflow?retryWrites=true&w=majority
MONGO_URI=

# ── Required in production (auto-required by server.js) ───────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Production: browser origins + proxy ───────────────────────────────────
# Comma-separated list of production browser origins allowed by CORS.
# Empty/missing = deny all browser origins (fail-closed).
# Example: ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=
# Set to `true` only behind a real reverse proxy (e.g. nginx). Trusting
# X-Forwarded-For on a directly-exposed server lets clients spoof IPs to
# bypass rate limits.
TRUST_PROXY=false

# ── Optional: Google OAuth ────────────────────────────────────────────────
# Get a client ID at https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=

# ── Optional: Resend (email) ──────────────────────────────────────────────
# Get a free API key at https://resend.com
# When empty, email sending is disabled (links still print to server console in dev)
RESEND_API_KEY=

# ── Optional: GitHub OAuth ────────────────────────────────────────────────
# Register at https://github.com/settings/developers. Both ID and secret are
# required to enable GitHub sign-in; when unset, GitHub auth is disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override; defaults to <CLIENT_URL>/api/auth/github/callback.
GITHUB_CALLBACK_URL=

# ── Optional: Redis (for multi-instance rate limiting) ────────────────────
# If unset, the rate limiter uses in-memory storage (single-instance only).
# Example: REDIS_URL=redis://localhost:6379
REDIS_URL=
